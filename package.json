{
	"name": "ng-hub-ui",
	"version": "22.6.1",
	"license": "MIT",
	"scripts": {
		"ng": "ng",
		"generate:tokens-data": "node scripts/generate-tokens-data.mjs",
		"generate:sitemap": "node scripts/generate-sitemap.mjs",
		"generate:fonts": "node scripts/generate-fonts.mjs",
		"generate:version": "node scripts/generate-version.mjs",
		"generate:library-versions": "node scripts/generate-library-versions.mjs",
		"generate:library-symbols": "node scripts/generate-library-symbols.mjs",
		"prestart": "npm run generate:tokens-data && npm run generate:version && npm run generate:library-versions && npm run generate:library-symbols",
		"start": "ng serve",
		"prebuild": "npm run generate:tokens-data && npm run generate:version && npm run generate:library-versions && npm run generate:library-symbols",
		"build": "ng build",
		"postbuild": "npm run generate:sitemap",
		"build:all-libs": "./build-all-libraries.sh",
		"deploy": "node scripts/deploy.mjs",
		"watch": "ng build --watch --configuration development",
		"pretest": "npm run generate:version && npm run generate:library-versions && npm run generate:library-symbols",
		"test": "ng test",
		"test:coverage": "ng test ng-hub-ui --no-watch --coverage",
		"lint": "eslint src",
		"format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"projects/**/src/**/*.{ts,html,scss}\" \"projects/*/package.json\"",
		"tokens:parity": "node scripts/tokens-parity.mjs",
		"docs:cssvars": "node scripts/generate-css-variables-docs.mjs",
		"docs:mixins": "node scripts/generate-mixins-docs.mjs",
		"publish": "node scripts/publish.js",
		"publish:utils": "npm run publish utils",
		"publish:action-sheet": "npm run publish action-sheet",
		"publish:paginable": "npm run publish paginable",
		"publish:portal": "npm run publish portal",
		"publish:modal": "npm run publish modal",
		"publish:metrics": "npm run publish metrics",
		"publish:milestones": "npm run publish milestones",
		"publish:stepper": "npm run publish stepper",
		"publish:breadcrumbs": "npm run publish breadcrumbs",
		"publish:avatar": "npm run publish avatar",
		"publish:board": "npm run publish board",
		"publish:calendar": "npm run publish calendar",
		"publish:history": "npm run publish history",
		"publish:sortable": "npm run publish sortable",
		"publish:nav": "npm run publish nav",
		"publish:skeleton": "npm run publish skeleton",
		"publish:panels": "npm run publish panels",
		"publish:forms": "npm run publish forms",
		"publish:ds": "npm run publish ds",
		"publish:buttons": "npm run publish buttons",
		"publish:badges": "npm run publish badges",
		"publish:icons": "npm run publish icons",
		"publish:toast": "npm run publish toast",
		"publish:signature": "npm run publish signature",
		"publish:loading": "npm run publish loading",
		"publish:installer": "npm run publish installer",
		"pretest:libs": "npm run generate:version && npm run generate:library-versions && npm run generate:library-symbols",
		"test:libs": "node scripts/test-libs.mjs"
	},
	"private": true,
	"dependencies": {
		"@angular/animations": "^22.0.8",
		"@angular/cdk": "^22.0.6",
		"@angular/common": "^22.0.8",
		"@angular/compiler": "^22.0.8",
		"@angular/core": "^22.0.8",
		"@angular/forms": "^22.0.8",
		"@angular/platform-browser": "^22.0.8",
		"@angular/platform-server": "^22.0.8",
		"@angular/router": "^22.0.8",
		"@angular/ssr": "^22.0.8",
		"gsap": "^3.15.0",
		"highlight.js": "^11.11.1",
		"lenis": "^1.3.25",
		"ngx-highlightjs": "^14.0.1",
		"rxjs": "~7.8.0",
		"sortablejs": "^1.15.7",
		"ts-md5": "^2.0.1",
		"tslib": "^2.3.0",
		"zone.js": "~0.16.2"
	},
	"devDependencies": {
		"@angular/build": "^22.0.8",
		"@angular/cli": "^22.0.8",
		"@angular/compiler-cli": "^22.0.8",
		"@eslint/js": "^10.0.1",
		"@types/node": "^22.18.0",
		"@types/sortablejs": "^1.15.9",
		"@vitest/coverage-v8": "^4.1.10",
		"angular-eslint": "^22.1.0",
		"eslint": "^10.8.0",
		"istanbul-lib-instrument": "^6.0.3",
		"jsdom": "^30.0.0",
		"ng-packagr": "^22.0.2",
		"prettier": "^3.9.6",
		"sass": "^1.99.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.0.8"
	}
}
